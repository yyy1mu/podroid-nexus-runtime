# Nexus QEMU-virt kernel configuration fragment.
#
# Build flow:
#   make ARCH=arm64 defconfig
#   make ARCH=arm64 virt.config
#   turn every inherited =m into "is not set"
#   merge this fragment and run olddefconfig
#
# The Android runtime exposes only QEMU virt devices. There is no USB
# passthrough, display, audio, physical SoC, KVM, Xen, or container backend.
# Every runtime driver is built in and loadable module support is disabled.

# Monolithic production kernel.
# CONFIG_MODULES is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_AUDIT is not set
# CONFIG_LOCKUP_DETECTOR is not set
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set

# Server/throughput scheduling under QEMU TCG.
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ=y
CONFIG_PREEMPT_NONE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_NR_CPUS=4
CONFIG_ARM64_4K_PAGES=y

# Keep low-cost production hardening. Runtime CPU mitigations are controlled
# by the Android QEMU command line, which already uses mitigations=off.
CONFIG_RANDOMIZE_BASE=y
CONFIG_RELOCATABLE=y
# CONFIG_STACKPROTECTOR is not set
# CONFIG_FORTIFY_SOURCE is not set
# CONFIG_HARDENED_USERCOPY is not set
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# QEMU mach-virt platform: device tree, GICv3, PL011, generic PCI and RTC.
CONFIG_OF=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_HOST_GENERIC=y
# CONFIG_PCIEPORTBUS is not set
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_PCI_IOV is not set
# CONFIG_PCI_ATS is not set
# CONFIG_PCI_PRI is not set
# CONFIG_PCI_PASID is not set
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# CONFIG_VT is not set
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_SERIAL_8250 is not set

# QEMU exposes only PCI virtio block, network, console and RNG devices.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
# CONFIG_VIRTIO_PCI_LEGACY is not set
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_INPUT is not set

# Boot and persistent storage.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_UNICODE=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_DECOMPRESS_ZSTD=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_MQ_IOSCHED_DEADLINE=y
# CONFIG_FUSE_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_9P_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_FAT_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set

# Compressed swap for the default 2 GiB guest.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZRAM_BACKEND_LZ4HC is not set
# CONFIG_ZRAM_BACKEND_ZSTD is not set
# CONFIG_ZRAM_BACKEND_DEFLATE is not set
# CONFIG_ZRAM_BACKEND_842 is not set
# CONFIG_ZRAM_BACKEND_LZO is not set
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZRAM_MULTI_COMP is not set

# SLIRP + virtio-net. TUN provides both TUN and TAP devices for guest tools.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_TBF=y
# CONFIG_NET_SCH_FQ_CODEL is not set
# CONFIG_VETH is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_DUMMY is not set
# CONFIG_NETFILTER is not set

# Process isolation remains available to Agent workloads, without the unused
# container networking and cgroup-controller stacks.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# CONFIG_CGROUPS is not set
# CONFIG_SCHED_AUTOGROUP is not set

# Runtime observability and executable formats used by Alpine/OpenCode.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y

# No nested virtualization, power management, hotplug or NUMA topology.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_XEN is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PM is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_NUMA is not set
# CONFIG_NUMA_BALANCING is not set
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_COMPAT is not set

# No host USB/libusb integration or physical peripheral buses.
# CONFIG_USB_SUPPORT is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set
# CONFIG_MEMSTICK is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_BT is not set
# CONFIG_RFKILL is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_FW_LOADER is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set

# Headless fixed-purpose VM: remove unrelated physical subsystems.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_INFINIBAND is not set
# CONFIG_EDAC is not set
# CONFIG_W1 is not set
# CONFIG_PCCARD is not set
# CONFIG_MTD is not set
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_EXTCON is not set
# CONFIG_IIO is not set
# CONFIG_PWM is not set
# CONFIG_REGULATOR is not set
# CONFIG_SLIMBUS is not set
# CONFIG_SPI is not set
# CONFIG_SURFACE_PLATFORMS is not set
