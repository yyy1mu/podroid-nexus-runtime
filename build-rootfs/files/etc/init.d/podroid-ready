#!/sbin/openrc-run
description="Podroid VM ready marker (consumed by Android boot detector)"

depend() {
    need podroid-network podroid-opencode
    after dropbear
}

start() {
    if ! ss -ltn 2>/dev/null | grep -qE '(^|:)4096[[:space:]]'; then
        echo "OpenCode failed to become ready" > /dev/console
        return 1
    fi

    # Keep the two runtime infrastructure processes ahead of user workloads
    # when the 2 GB guest is under memory pressure.
    for _name in dropbear opencode; do
        for _pid in $(pgrep -x "$_name" 2>/dev/null); do
            echo -1000 > "/proc/$_pid/oom_score_adj" 2>/dev/null
        done
    done

    # Emit the boot stages consumed by the Nexus Android boot detector.
    echo "Starting SSH..." > /dev/console
    echo "Almost ready..." > /dev/console
    echo "Ready!" > /dev/console
    return 0
}

stop() {
    return 0
}
