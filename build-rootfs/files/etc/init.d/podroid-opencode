#!/sbin/openrc-run
description="opencode AI coding server (0.0.0.0:4096)"

# Password override: put OC_PASSWORD=... in /etc/conf.d/podroid-opencode.
[ -f /etc/conf.d/podroid-opencode ] && . /etc/conf.d/podroid-opencode
: "${OC_PASSWORD:=secret}"

depend() {
    need podroid-bootstrap
    after podroid-network
    before podroid-ready
}

start() {
    ebegin "Starting opencode server (0.0.0.0:4096)"
    : > /var/log/opencode.log
    rm -f /run/podroid-opencode.pid
    start-stop-daemon --start --background \
        --pidfile /run/podroid-opencode.pid --make-pidfile \
        --stdout /var/log/opencode.log --stderr /var/log/opencode.log \
        --env "OPENCODE_SERVER_PASSWORD=${OC_PASSWORD}" \
        --exec /usr/local/bin/opencode -- \
        serve --hostname 0.0.0.0 --port 4096
    _rc=$?

    # OpenCode/Bun can need more than OpenRC's dependency timeout to load under
    # QEMU TCG. The service start operation must therefore return immediately;
    # podroid-ready owns the longer readiness wait.
    if [ "$_rc" -eq 0 ]; then
        _pid=$(cat /run/podroid-opencode.pid 2>/dev/null)
        [ -n "$_pid" ] && kill -0 "$_pid" 2>/dev/null || _rc=1
    fi
    if [ "$_rc" -ne 0 ]; then
        ewarn "opencode failed to start (see /var/log/opencode.log)"
    fi
    eend $_rc
}

stop() {
    ebegin "Stopping opencode server"
    start-stop-daemon --stop --pidfile /run/podroid-opencode.pid 2>/dev/null
    eend 0
}
